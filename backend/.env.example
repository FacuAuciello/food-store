#variables de entorno del backend: copiar este archivo como .env y ajustar los valores
#conexion a la base de datos con postgresql
#para desarrollo local sin postgresql se puede usar sqlite:///./foodstore.db como valor
DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db

#clave para firmar el jwt, minimo 32 caracteres
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres

#algoritmo del jwt
ALGORITHM=HS256

#minutos de vida del token y de la cookie
ACCESS_TOKEN_EXPIRE_MINUTES=30

#origen del frontend permitido por cors
FRONTEND_ORIGIN=http://localhost:5173
